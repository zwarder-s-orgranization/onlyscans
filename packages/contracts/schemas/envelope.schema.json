{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secflow.local/schemas/envelope.schema.json",
  "title": "SecFlow Branch-Local Envelope (ADR-0004)",
  "description": "Data payload passed across Workflow edges and stored in Garage (secflow-artifacts/{run_id}/{node_id}/in.json, out.json, and optional out.{sourceHandle}.json for multi-port branching nodes) for Envelope Inspector and Re-run from Node. Branch-local filtering via logic.filter/logic.regex narrows Envelope.findings without modifying authoritative Run Findings.",
  "type": "object",
  "required": ["trigger", "findings", "stats", "vars"],
  "additionalProperties": false,
  "properties": {
    "trigger": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["MANUAL", "SCHEDULE", "WEBHOOK", "CI_API", "MCP", "RERUN"]
        },
        "repoUrl": { "type": "string" },
        "branch": { "type": "string" },
        "commitSha": { "type": "string" },
        "prNumber": { "type": ["integer", "null"] },
        "gitProvider": {
          "type": ["string", "null"],
          "enum": ["GITHUB", "GITLAB", "", null]
        },
        "deliveryId": { "type": "string" },
        "triggeredBy": { "type": "string" },
        "commitStatusUrl": { "type": "string" },
        "triggeredAt": { "type": "string", "format": "date-time" }
      }
    },
    "sourceRef": {
      "type": ["object", "null"],
      "required": ["sourceId", "bucket", "key", "sha256", "repoName"],
      "additionalProperties": false,
      "properties": {
        "sourceId": { "type": "string" },
        "bucket": { "const": "secflow-sources" },
        "key": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "repoName": { "type": "string" },
        "repoUrl": { "type": "string" },
        "gitRef": { "type": "string" },
        "commitSha": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "fileCount": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "description": "Branch-local deduplicated findings with stable findingId. Secrets are ALWAYS masked.",
      "items": {
        "type": "object",
        "required": ["findingId", "fingerprint", "sourceNodeId", "pluginId", "category", "path"],
        "additionalProperties": false,
        "properties": {
          "findingId": { "type": "string" },
          "fingerprint": { "type": "string" },
          "sourceNodeId": { "type": "string" },
          "pluginId": { "type": "string" },
          "category": { "type": "string", "enum": ["SECRET", "SAST", "SCA"] },
          "path": { "type": "string" },
          "class": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "group": { "type": "string" },
          "artifact": { "type": "string" },
          "version": { "type": "string" },
          "advisoryId": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "description": { "type": "string" },
          "remediation": { "type": "string" },
          "maskedSnippet": { "type": "string" },
          "isNewVsBaseline": { "type": "boolean" }
        }
      }
    },
    "sbomRef": {
      "type": ["object", "null"],
      "required": ["bucket", "key", "digest", "specVersion"],
      "additionalProperties": false,
      "properties": {
        "bucket": { "const": "secflow-sbom" },
        "key": { "type": "string" },
        "digest": { "type": "string" },
        "specVersion": { "const": "1.6" },
        "componentCount": { "type": "integer", "minimum": 0 },
        "vulnerabilityCount": { "type": "integer", "minimum": 0 },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "aiReport": {
      "type": ["object", "null"],
      "required": [
        "quality",
        "releaseDecision",
        "executiveSummary",
        "groups",
        "items",
        "modelId",
        "providerMode",
        "privacyMode",
        "strippedHallucinatedAdvisories",
        "cached",
        "promptHash",
        "tokensIn",
        "tokensOut",
        "latencyMs",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "quality": { "type": "string", "enum": ["VERIFIED", "DEGRADED", "FALLBACK"] },
        "releaseDecision": { "type": "string", "enum": ["PASS", "WARN", "BLOCK"] },
        "executiveSummary": { "type": "string" },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "maxSeverity", "findingIds", "summary"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "maxSeverity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
              "findingIds": { "type": "array", "items": { "type": "string" } },
              "summary": { "type": "string" }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "findingId",
              "priorityRank",
              "plainLanguageRisk",
              "businessImpact",
              "remediationSteps",
              "referencedAdvisories",
              "finding"
            ],
            "additionalProperties": false,
            "properties": {
              "findingId": { "type": "string" },
              "priorityRank": { "type": "integer", "minimum": 1 },
              "plainLanguageRisk": { "type": "string" },
              "businessImpact": { "type": "string" },
              "remediationSteps": { "type": "array", "items": { "type": "string" } },
              "referencedAdvisories": { "type": "array", "items": { "type": "string" } },
              "finding": {
                "type": "object",
                "required": ["category", "path"],
                "additionalProperties": false,
                "properties": {
                  "category": { "type": "string", "enum": ["SECRET", "SAST", "SCA"] },
                  "path": { "type": "string" },
                  "line": { "type": ["integer", "null"], "minimum": 1 },
                  "endLine": { "type": ["integer", "null"], "minimum": 1 },
                  "findingClass": { "type": ["string", "null"] },
                  "group": { "type": ["string", "null"] },
                  "artifact": { "type": ["string", "null"] },
                  "version": { "type": ["string", "null"] },
                  "advisoryId": { "type": ["string", "null"] },
                  "severity": {
                    "type": ["string", "null"],
                    "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]
                  }
                }
              }
            }
          }
        },
        "modelId": { "type": "string" },
        "providerMode": { "type": "string", "enum": ["CLOUD", "OLLAMA", "TEMPLATE_FALLBACK"] },
        "privacyMode": { "type": "string", "enum": ["REDACTED_SNIPPET", "METADATA_ONLY"] },
        "strippedHallucinatedAdvisories": { "type": "integer", "minimum": 0 },
        "cached": { "type": "boolean" },
        "promptHash": { "type": "string" },
        "tokensIn": { "type": "integer", "minimum": 0 },
        "tokensOut": { "type": "integer", "minimum": 0 },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "gate": {
      "type": ["object", "null"],
      "required": ["status", "reason", "nodeId"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "reason": { "type": "string" },
        "nodeId": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "description": "Flat EnvelopeStats aligned 1:1 with common.proto EnvelopeStats and GraphQL EnvelopeStats.",
      "required": [
        "total",
        "newCount",
        "critical",
        "high",
        "medium",
        "low",
        "secretCount",
        "sastCount",
        "scaCount"
      ],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "newCount": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "secretCount": { "type": "integer", "minimum": 0 },
        "sastCount": { "type": "integer", "minimum": 0 },
        "scaCount": { "type": "integer", "minimum": 0 },
        "maxSeverity": {
          "type": ["string", "null"],
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", null]
        }
      }
    },
    "vars": {
      "type": "object",
      "description": "Arbitrary non-secret key/value metadata emitted by plugins (e.g. mcp.tool outputs, export URLs).",
      "additionalProperties": true
    }
  }
}
