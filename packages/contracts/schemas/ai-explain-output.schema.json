{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secflow.local/schemas/ai-explain-output.schema.json",
  "title": "SecFlow ai.explain Strict LLM Output Schema (T7)",
  "description": "Strict JSON Schema enforced on raw LLM responses in ai-service before Two-Stage Grounding. Grounding rules: (1) every findingId MUST exist in the deterministic input findings list; (2) authoritative path/line/group/artifact/version/advisoryId are re-attached deterministically from Run Findings; (3) ALL strings (executiveSummary, group summaries, plainLanguageRisk, businessImpact, remediationSteps) AND referencedAdvisories[] are regex-scanned for CVE-\\d{4}-\\d{4,7}|GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4} and any advisory not in the SCA allowlist is stripped with aiQuality=DEGRADED.",
  "type": "object",
  "required": ["releaseDecision", "executiveSummary", "groups", "items"],
  "additionalProperties": false,
  "properties": {
    "releaseDecision": {
      "type": "string",
      "enum": ["PASS", "WARN", "BLOCK"]
    },
    "executiveSummary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "maxSeverity", "findingIds", "summary"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "maxSeverity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "findingIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^F-[0-9]{3,}$" }
          },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "priorityRank",
          "plainLanguageRisk",
          "businessImpact",
          "remediationSteps",
          "referencedAdvisories"
        ],
        "additionalProperties": false,
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "priorityRank": {
            "type": "integer",
            "minimum": 1
          },
          "plainLanguageRisk": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "businessImpact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "remediationSteps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string", "minLength": 1, "maxLength": 600 }
          },
          "referencedAdvisories": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(CVE-\\d{4}-\\d{4,7}|GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4})$"
            }
          }
        }
      }
    }
  }
}
